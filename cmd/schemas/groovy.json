{
  "version": "v1",
  "nodes": [
    {
      "name": "package",
      "selector": "$",
      "children": [
        {
          "name": "{{.index}}",
          "selector": "(groovy_package) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    },
    {
      "name": "imports",
      "selector": "$",
      "children": [
        {
          "name": "{{.index}}",
