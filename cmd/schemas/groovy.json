            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    },
    {
      "name": "functions",
      "selector": "$",
      "children": [
        {
          "name": "{{.index}}",
          "selector": "(function_definition) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        },
        {
          "name": "{{.index}}",
          "selector": "(function_declaration) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    }
  ]
}
