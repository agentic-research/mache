{
  "version": "v1",
  "nodes": [
    {
      "name": "messages",
      "selector": "$",
      "children": [
        {
          "name": "{{.name}}",
          "selector": "(message (message_name) @name) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    },
    {
      "name": "services",
      "selector": "$",
      "children": [
        {
          "name": "{{.name}}",
          "selector": "(service (service_name) @name) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    },
    {
      "name": "enums",
      "selector": "$",
      "children": [
        {
          "name": "{{.name}}",
          "selector": "(enum (enum_name) @name) @scope",
          "files": [
            {
              "name": "source",
              "content_template": "{{.scope}}"
            }
          ]
        }
      ]
    }
  ]
}
