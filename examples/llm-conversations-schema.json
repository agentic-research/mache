{
  "version": "v1",
  "nodes": [
    {
      "name": "{{.provider}}",
      "selector": "$[*]",
      "children": [
        {
          "name": "{{slice .created 0 7}}",
          "selector": "$",
          "children": [
            {
              "name": "{{.model}}",
              "selector": "$",
              "children": [
                {
                  "name": "{{.id}}",
                  "selector": "$",
                  "files": [
                    {
                      "name": "title",
                      "content_template": "{{.title}}"
                    },
                    {
                      "name": "transcript",
                      "content_template": "{{range .messages}}[{{.role}}] {{.content}}\n\n{{end}}"
                    },
                    {
                      "name": "system-prompt",
                      "content_template": "{{default .system_prompt \"\"}}"
                    },
                    {
                      "name": "token-usage",
                      "content_template": "input: {{.usage.input_tokens}}\noutput: {{.usage.output_tokens}}\ntotal: {{.usage.total_tokens}}"
                    },
                    {
                      "name": "raw.json",
                      "content_template": "{{. | json}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
