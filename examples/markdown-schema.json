{
  "version": "v1",
  "nodes": [
    {
      "name": "sections",
      "selector": "$",
      "children": [
        {
          "name": "{{.name}}",
          "selector": "(section (atx_heading (inline) @name)) @scope",
          "refs": ["heading-{{.name}}"],
          "files": [
            {"name": "source", "content_template": "{{.scope}}"}
          ]
        }
      ]
    },
    {
      "name": "code",
      "selector": "$",
      "children": [
        {
          "name": "{{.lang}}",
          "selector": "(fenced_code_block (info_string (language) @lang)) @scope",
          "files": [
            {"name": "source", "content_template": "{{.scope}}"}
          ]
        }
      ]
    }
  ]
}
